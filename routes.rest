// LOCALHOST
@localhostNum = 3000

### Get all contacts
GET http://localhost:{{localhostNum}}/contacts

### Get a contact by ID
@getContactById = 69614baa20f150c86dfa689d
GET http://localhost:{{localhostNum}}/contacts/{{getContactById}}

### Create a new contact
POST http://localhost:{{localhostNum}}/contacts HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@email.com",
  "favoriteColor": "blue",
  "birthday": "1998/7/15"
}

### Update a contact by ID
@updateContactById = 697e0b403c0144b2ab3a72a4
PUT http://localhost:{{localhostNum}}/contacts/{{updateContactById}} HTTP/1.1
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@email.com",
  "favoriteColor": "green",
  "birthday": "1998/7/15"
}

### Delete a contact by ID
@deleteContactById = 697e0b423c0144b2ab3a72a5
DELETE http://localhost:{{localhostNum}}/contacts/{{deleteContactById}}